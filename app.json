{
  "expo": {
    "name": "SmsBroadcast",
    "slug": "SmsBroadcast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sms-broadcast-logo.png",
    "scheme": "smsbroadcast",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ronald.smsBroadcast"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sms-broadcast-foreground.png",
        "backgroundImage": "./assets/images/sms-broadcast-background.png",
        "monochromeImage": "./assets/images/sms-broadcast-notification.png"
      },
      "permissions": [
        "android.permission.SEND_SMS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ronald.smsBroadcast"
    },
    "notification": {
      "icon": "./assets/images/sms-broadcast-notification.png",
      "color": "#0a7ea4"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sms-broadcast-splashscreen.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#151718"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "fr"
            ],
            "android": [
              "en",
              "fr"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d8daf92-c70e-4c46-9f5f-979405735281"
      }
    }
  }
}